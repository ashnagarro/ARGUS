{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "configuration": {
    "provider_config": {
      "aws": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "expressions": {
          "region": {"constant_value": "us-east-1"},
          "access_key": {"constant_value": "FAKE_ACCESS_KEY"},
          "secret_key": {"constant_value": "FAKE_SECRET_KEY"},
          "skip_credentials_validation": {"constant_value": true}
        }
      },
      "aws.west": {
        "name": "aws",
        "full_name": "registry.terraform.io/hashicorp/aws",
        "alias": "west",
        "expressions": {
          "region": {"constant_value": "us-west-2"},
          "access_key": {"constant_value": "FAKE_ACCESS_KEY"},
          "secret_key": {"constant_value": "FAKE_SECRET_KEY"},
          "skip_credentials_validation": {"constant_value": true}
        }
      }
    },
    "root_module": {
      "resources": [
        {"address": "aws_db_option_group.synthetic_restore", "type": "aws_db_option_group", "provider_config_key": "aws"},
        {"address": "aws_db_instance.synthetic_source", "type": "aws_db_instance", "provider_config_key": "aws"},
        {"address": "aws_db_instance.synthetic_replica", "type": "aws_db_instance", "provider_config_key": "aws.west"}
      ]
    }
  },
  "resource_changes": [
    {
      "address": "aws_db_option_group.synthetic_restore",
      "mode": "managed",
      "type": "aws_db_option_group",
      "name": "synthetic_restore",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": ["no-op"],
        "before": {"name": "synthetic-restore-options", "engine_name": "sqlserver-ee", "major_engine_version": "15.00", "option": [{"option_name": "SQLSERVER_BACKUP_RESTORE"}]},
        "after": {"name": "synthetic-restore-options", "engine_name": "sqlserver-ee", "major_engine_version": "15.00", "option": [{"option_name": "SQLSERVER_BACKUP_RESTORE"}]}
      }
    },
    {
      "address": "aws_db_instance.synthetic_source",
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "synthetic_source",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": ["no-op"],
        "before": {"identifier": "synthetic-sqlserver-source", "engine": "sqlserver-ee", "engine_version": "15.00", "instance_class": "db.m5.xlarge", "option_group_name": "synthetic-restore-options", "backup_retention_period": 7},
        "after": {"identifier": "synthetic-sqlserver-source", "engine": "sqlserver-ee", "engine_version": "15.00", "instance_class": "db.m5.xlarge", "option_group_name": "synthetic-restore-options", "backup_retention_period": 7}
      }
    },
    {
      "address": "aws_db_instance.synthetic_replica",
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "synthetic_replica",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {"identifier": "synthetic-sqlserver-replica", "engine": "sqlserver-ee", "engine_version": "15.00", "instance_class": "db.m5.xlarge", "replicate_source_db": "synthetic-sqlserver-source"},
        "after_unknown": {},
        "before_sensitive": {},
        "after_sensitive": {}
      }
    }
  ]
}
